# Python bytecode (the scripts run with -I and dont_write_bytecode, but a plain run can still create these)
__pycache__/
*.py[cod]

# Review output never belongs in this repository: ledgers, inventories and reports hold attack details
coverage-ledger*.json
inventory*.json
accepted-risks*
*-review.txt

